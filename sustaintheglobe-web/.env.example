# AWS mode: set VITE_BACKEND=aws. Firebase vars are NOT used in AWS mode, leave blank.
# Firebase-local mode: set VITE_BACKEND=firebase and fill VITE_FIREBASE_* from Firebase console.
VITE_BACKEND=aws
# FIND THIS: real API Gateway URL from `sam deploy` outputs.
# Looks like: https://xxxx.execute-api.us-east-1.amazonaws.com/Prod/
VITE_API_URL=PASTE_API_GATEWAY_URL_HERE
# FIND THESE in `sam deploy` Outputs (keys: UserPoolId, UserPoolClientId, Region).
# No secret is used by the browser — the client ID is public by design.
VITE_COGNITO_USER_POOL_ID=PASTE_USER_POOL_ID_HERE
VITE_COGNITO_CLIENT_ID=PASTE_APP_CLIENT_ID_HERE
VITE_COGNITO_REGION=us-east-1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_SOME_KEY=
